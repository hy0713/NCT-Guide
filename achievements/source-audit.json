  "requiredAnswers": [
    {
      "id": 729,
      "english": "I will pledge a new commitment to liberalism and economic revival. Our social programs and unions need to be protected. In those areas where Republicans continue to stand in the way of progress, we will look for other ways to get things done.",
      "chinese": "我会承诺重新致力于自由主义和经济振兴。我们的社会福利计划和工会需要保护。在共和党继续阻碍进步的领域，我们会寻找其他办法把事情办成。",
      "scopes": [
        "2012_Obama_Biden",
        "2012_Obama_Clinton"
      ]
    },
    {
      "id": 330,
      "english": "I will talk at great length about how we've drifted from the tradition of liberalism that was built by the likes of Roosevelt, Johnson, and Humphrey. I will reaffirm my commitment to this vision in my second term.",
      "chinese": "我会详细谈谈，我们如何偏离了罗斯福、约翰逊和汉弗莱等人建立的自由主义传统。我会重申，第二任期将致力于实现这一愿景。",
      "scopes": [
        "2012_Obama_Biden",
        "2012_Obama_Clinton"
      ]
    },
    {
      "id": 168,
      "english": "There should be a public insurance company offering health care to all Americans. Private insurers are simply too greedy and too likely to turn down people with pre-existing health conditions.",
      "chinese": "应该设立一家公共保险机构，为所有美国人提供医疗保障。私人保险公司实在太贪婪，也太容易拒绝有既往病史的人。",
      "scopes": [
        "2012_Obama_Biden",
        "2012_Obama_Clinton",
        "2012_Romney_Ryan",
        "2012_Romney_Portman",
        "2012_Romney_Rubio",
        "2012_Romney_Pawlenty"
      ]
    },
    {
      "id": 3326,
      "english": "Bill Clinton was an embarrassment to the United States, and his impeachment was well-deserved. I believe that he should have been removed from office.",
      "chinese": "比尔·克林顿让美国蒙羞，他遭到弹劾是罪有应得。我认为他应当被免职。",
      "scopes": [
        "2000_Bush_Cheney",
        "2000_Bush_Danforth",
        "2000_Bush_Ridge",
        "2000_Bush_Powell",
        "2000_Gore_Lieberman",
        "2000_Gore_Graham",
        "2000_Gore_Kerry",
        "2000_Gore_Bayh",
        "2000_Nader_LaDuke"
      ]
    },
    {
      "id": 4439,
      "english": "We need to change the imagery on this issue. Let's do a photo-op of me riding in a tank.",
      "chinese": "我们得改变公众在这个问题上对我的印象。安排我乘坐坦克拍一组宣传照吧。",
      "scopes": [
        "1988_Dukakis_Bentsen",
        "1988_Dukakis_Glenn",
        "1988_Dukakis_Gore",
        "1988_Dukakis_Jackson"
      ]
    },
